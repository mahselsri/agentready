# Report storage on Vercel (added automatically when you connect an Upstash Redis database).
# Without these, share links work locally (saved to disk) but are switched off on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shown in the crawler's User-Agent. Use a real email or URL.
AUDIT_BOT_CONTACT=

# Public URL of the site, used for link previews. Optional on Vercel.
NEXT_PUBLIC_SITE_URL=

# Expert-request flow (off by default). Set to 1 and rebuild to enable.
NEXT_PUBLIC_ENABLE_EXPERTS=
LEADS_WEBHOOK_URL=

# NEVER set in production:
# AUDIT_ALLOW_PRIVATE=1
